---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	start_turn(start_turn)
	gate(gate)
	refuse(refuse)
	load_memory(load_memory)
	remember(remember)
	ack(ack)
	chat(chat)
	recommender(recommender)
	info(info)
	tools(tools)
	validate(validate)
	revise(revise)
	fallback(fallback)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> start_turn;
	ack --> finalize;
	chat --> finalize;
	fallback --> finalize;
	gate -.-> load_memory;
	gate -.-> refuse;
	info -.-> tools;
	info -.-> validate;
	load_memory -.-> ack;
	load_memory -.-> chat;
	load_memory -.-> info;
	load_memory -.-> recommender;
	load_memory -.-> remember;
	recommender -.-> tools;
	recommender -.-> validate;
	refuse --> finalize;
	remember -.-> ack;
	remember -.-> chat;
	remember -.-> info;
	remember -.-> recommender;
	revise -.-> info;
	revise -.-> recommender;
	start_turn --> gate;
	tools -.-> info;
	tools -.-> recommender;
	validate -.-> fallback;
	validate -.-> finalize;
	validate -.-> revise;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

